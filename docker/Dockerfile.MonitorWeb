# Etapa build: compila el front con Node
FROM node:24-alpine AS build
WORKDIR /src/web
COPY ./web/package.json ./web/package-lock.json ./
RUN npm ci
COPY ./web .
RUN npm run build

# Etapa final: nginx sin privilegios (spec 16, B-7) sirviendo el build estático. Corre como
# usuario no-root y escucha en 8080 (un puerto <1024 exigiría root).
FROM nginxinc/nginx-unprivileged:alpine AS final
COPY --from=build /src/web/dist /usr/share/nginx/html
COPY ./docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
