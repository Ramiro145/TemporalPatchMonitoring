# Etapa base: runtime de ASP.NET
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app

# Etapa build: SDK para compilar
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copiar primero los csproj para aprovechar la caché de restore
COPY ./src/Common/Common.csproj ./Common/
COPY ./src/Contracts/Contracts.csproj ./Contracts/
COPY ./src/MonitorApi/MonitorApi.csproj ./MonitorApi/
RUN dotnet restore ./MonitorApi/MonitorApi.csproj

# Copiar el resto del código
COPY ./src/Common ./Common
COPY ./src/Contracts ./Contracts
COPY ./src/MonitorApi ./MonitorApi
WORKDIR /src/MonitorApi
RUN dotnet publish -c Release -o /app/publish

# Etapa final: runtime ASP.NET
FROM base AS final
WORKDIR /app
EXPOSE 5100
COPY --from=build /app/publish .
# No-root (spec 16, B-7): el usuario "app" ya viene en la imagen aspnet:8.0; 5100 no es privilegiado.
USER $APP_UID
ENTRYPOINT ["dotnet", "MonitorApi.dll"]
